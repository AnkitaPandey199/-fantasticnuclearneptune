---
import Layout from '../layouts/Layout.astro';

const initialArtworks = [
  {
    id: 1,
    title: "Monsoon Reflections on Canvas",
    artist: "Aarav Sharma",
    handle: "@aarav.studio",
    location: "New Delhi, India",
    category: "Painting",
    price: "$240",
    forSale: true,
    likes: 128,
    image: "https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=800&q=80",
    medium: "Acrylic on Cloth Canvas • 24x36 in"
  },
  {
    id: 2,
    title: "Cybernetic Flora IV",
    artist: "Elena Rostova",
    handle: "@elena_renders",
    location: "Berlin, Germany",
    category: "Digital",
    price: "$95",
    forSale: true,
    likes: 342,
    image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80",
    medium: "3D Digital Sculpture • 4K Print"
  },
  {
    id: 3,
    title: "Solitude in Terracotta",
    artist: "Mateo Silva",
    handle: "@mateo.clay",
    location: "Oaxaca, Mexico",
    category: "Sculpture",
    price: "Showcase Only",
    forSale: false,
    likes: 89,
    image: "https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=800&q=80",
    medium: "Hand-thrown Stoneware • 14 in"
  },
  {
    id: 4,
    title: "Nocturne in Ink & Gold",
    artist: "Kenji Takahashi",
    handle: "@kenji_ink",
    location: "Kyoto, Japan",
    category: "Illustration",
    price: "$180",
    forSale: true,
    likes: 215,
    image: "https://images.unsplash.com/photo-1541961017774-22349e4a1262?auto=format&fit=crop&w=800&q=80",
    medium: "Sumi Ink & Gold Leaf on Washi"
  }
];
---

<Layout>
  <div class="art-app">
    <!-- Top Navigation -->
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand">
          <span class="brand-dot"></span>
          Atelier<strong>Global</strong>
        </a>
        <nav class="nav-links">
          <button class="filter-btn active" data-filter="All">Explore Feed</button>
          <button class="filter-btn" data-filter="Painting">Paintings</button>
          <button class="filter-btn" data-filter="Digital">Digital</button>
          <button class="filter-btn" data-filter="Illustration">Illustration</button>
          <button class="filter-btn" data-filter="ForSale">Marketplace</button>
        </nav>
        <button id="openPostModal" class="btn-primary">+ Post Artwork</button>
      </div>
    </header>

    <!-- Hero Banner -->
    <section class="hero">
      <div class="hero-content">
        <span class="badge">Global Artist Community & Marketplace</span>
        <h1>Share your vision. Sell your craft worldwide.</h1>
        <p>
          A social studio where creators from every corner of the globe publish works-in-progress,
          build a collector following, and sell original art directly without gallery gatekeepers.
        </p>
      </div>
    </section>

    <!-- Main Social + Marketplace Feed -->
    <main class="feed-container">
      <div id="artGrid" class="art-grid">
        {initialArtworks.map((art) => (
          <article class="art-card" data-category={art.category} data-sale={art.forSale ? "true" : "false"}>
            <div class="card-header">
              <div class="artist-info">
                <div class="avatar">{art.artist.charAt(0)}</div>
                <div>
                  <h3>{art.artist}</h3>
                  <span class="meta">{art.handle} • {art.location}</span>
                </div>
              </div>
              <span class={`status-tag ${art.forSale ? 'sale' : 'showcase'}`}>
                {art.forSale ? art.price : 'Showcase'}
              </span>
            </div>

            <div class="image-wrapper">
              <img src={art.image} alt={art.title} loading="lazy" />
            </div>

            <div class="card-body">
              <div class="title-row">
                <h2>{art.title}</h2>
                <span class="category-pill">{art.category}</span>
              </div>
              <p class="medium">{art.medium}</p>

              <div class="card-actions">
                <button class="like-btn" type="button">
                  ♥ <span class="like-count">{art.likes}</span>
                </button>
                {art.forSale ? (
                  <button class="buy-btn" data-title={art.title} data-price={art.price}>
                    Collect • {art.price}
                  </button>
                ) : (
                  <button class="inquire-btn" data-title={art.title}>
                    Appreciate
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>

    <!-- Post New Artwork Modal -->
    <dialog id="postModal" class="modal">
      <form id="artForm" method="dialog" class="modal-form">
        <div class="modal-header">
          <h2>Publish to Global Feed</h2>
          <button type="button" id="closeModal" class="close-x">&times;</button>
        </div>

        <label>
          Artwork Title
          <input type="text" id="artTitle" placeholder="e.g., Sunset over Yamuna" required />
        </label>

        <div class="form-row">
          <label>
            Your Name
            <input type="text" id="artistName" placeholder="e.g., Ankita" required />
          </label>
          <label>
            City, Country
            <input type="text" id="artistLocation" placeholder="e.g., Noida, India" required />
          </label>
        </div>

        <div class="form-row">
          <label>
            Category
            <select id="artCategory">
              <option value="Painting">Painting</option>
              <option value="Digital">Digital</option>
              <option value="Illustration">Illustration</option>
              <option value="Sculpture">Sculpture</option>
            </select>
          </label>
          <label>
            Listing Type & Price (USD)
            <input type="text" id="artPrice" placeholder="e.g., $150 or leave blank for Showcase" />
          </label>
        </div>

        <label>
          Medium & Dimensions
          <input type="text" id="artMedium" placeholder="e.g., Acrylic on Canvas • 18x24 in" required />
        </label>

        <label>
          Image URL
          <input
            type="url"
            id="artImage"
            value="https://images.unsplash.com/photo-1578301978693-85fa9c0320b9?auto=format&fit=crop&w=800&q=80"
            required
          />
        </label>

        <div class="modal-footer">
          <button type="submit" class="btn-primary full-width">Publish Artwork Now</button>
        </div>
      </form>
    </dialog>
  </div>
</Layout>

<script>
  // Category & Marketplace Filtering
  const filterBtns = document.querySelectorAll('.filter-btn');
  const artGrid = document.getElementById('artGrid');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.getAttribute('data-filter');

      document.querySelectorAll('.art-card').forEach((card) => {
        const el = card as HTMLElement;
        const category = el.getAttribute('data-category');
        const isSale = el.getAttribute('data-sale') === 'true';

        if (filter === 'All') {
          el.style.display = 'flex';
        } else if (filter === 'ForSale') {
          el.style.display = isSale ? 'flex' : 'none';
        } else {
          el.style.display = category === filter ? 'flex' : 'none';
        }
      });
    });
  });

  // Like & Collect Interactions (Delegated so newly posted cards also work)
  artGrid?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const likeBtn = target.closest('.like-btn');
    if (likeBtn) {
      const countSpan = likeBtn.querySelector('.like-count');
      if (countSpan) {
        const liked = likeBtn.classList.toggle('liked');
        const current = parseInt(countSpan.textContent || '0', 10);
        countSpan.textContent = String(liked ? current + 1 : current - 1);
      }
    }

    const buyBtn = target.closest('.buy-btn');
    if (buyBtn) {
      const title = buyBtn.getAttribute('data-title');
      const price = buyBtn.getAttribute('data-price');
      alert(`Added "${title}" (${price}) to your collector bag!`);
    }
  });

  // Post New Artwork Modal Logic
  const modal = document.getElementById('postModal') as HTMLDialogElement;
  const openBtn = document.getElementById('openPostModal');
  const closeBtn = document.getElementById('closeModal');
  const artForm = document.getElementById('artForm') as HTMLFormElement;

  openBtn?.addEventListener('click', () => modal?.showModal());
  closeBtn?.addEventListener('click', () => modal?.close());

  artForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    const title = (document.getElementById('artTitle') as HTMLInputElement).value;
    const artist = (document.getElementById('artistName') as HTMLInputElement).value;
    const location = (document.getElementById('artistLocation') as HTMLInputElement).value;
    const category = (document.getElementById('artCategory') as HTMLSelectElement).value;
    const rawPrice = (document.getElementById('artPrice') as HTMLInputElement).value.trim();
    const medium = (document.getElementById('artMedium') as HTMLInputElement).value;
    const image = (document.getElementById('artImage') as HTMLInputElement).value;

    const forSale = rawPrice.length > 0;
    const displayPrice = forSale ? (rawPrice.startsWith('$') ? rawPrice : `$${rawPrice}`) : 'Showcase';
    const handle = `@${artist.toLowerCase().replace(/\s+/g, '')}`;

    const newCard = document.createElement('article');
    newCard.className = 'art-card';
    newCard.setAttribute('data-category', category);
    newCard.setAttribute('data-sale', forSale ? 'true' : 'false');

    newCard.innerHTML = `
      <div class="card-header">
        <div class="artist-info">
          <div class="avatar">${artist.charAt(0).toUpperCase()}</div>
          <div>
            <h3>${artist}</h3>
            <span class="meta">${handle} • ${location}</span>
          </div>
        </div>
        <span class="status-tag ${forSale ? 'sale' : 'showcase'}">${displayPrice}</span>
      </div>
      <div class="image-wrapper">
        <img src="${image}" alt="${title}" />
      </div>
      <div class="card-body">
        <div class="title-row">
          <h2>${title}</h2>
          <span class="category-pill">${category}</span>
        </div>
        <p class="medium">${medium}</p>
        <div class="card-actions">
          <button class="like-btn" type="button">♥ <span class="like-count">1</span></button>
          ${
            forSale
              ? `<button class="buy-btn" data-title="${title}" data-price="${displayPrice}">Collect • ${displayPrice}</button>`
              : `<button class="inquire-btn" data-title="${title}">Appreciate</button>`
          }
        </div>
      </div>
    `;

    artGrid?.prepend(newCard);
    artForm.reset();
    modal?.close();
  });
</script>

<style>
  :global(body) {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: #faf9f6;
    color: #18181b;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(250, 249, 246, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #e4e4e7;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    text-decoration: none;
    color: #18181b;
    letter-spacing: -0.02em;
  }

  .brand-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e11d48, #f59e0b);
  }

  .nav-links {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid transparent;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.9rem;
    cursor: pointer;
    color: #52525b;
    transition: all 0.2s;
  }

  .filter-btn:hover {
    background: #f4f4f5;
    color: #18181b;
  }

  .filter-btn.active {
    background: #18181b;
    color: #ffffff;
  }

  .btn-primary {
    background: #18181b;
    color: #ffffff;
    border: none;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.15s, background 0.2s;
  }

  .btn-primary:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    text-align: center;
  }

  .badge {
    display: inline-block;
    background: #fef3c7;
    color: #92400e;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 auto 0.75rem;
    max-width: 720px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .hero p {
    max-width: 600px;
    margin: 0 auto;
    color: #52525b;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .feed-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .art-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.75rem;
  }

  .art-card {
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .art-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.07);
  }

  .card-header {
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .artist-info {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #18181b;
    color: #ffffff;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .artist-info h3 {
    margin: 0;
    font-size: 0.92rem;
  }

  .meta {
    font-size: 0.78rem;
    color: #71717a;
  }

  .status-tag {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
  }

  .status-tag.sale {
    background: #ecfdf5;
    color: #065f46;
  }

  .status-tag.showcase {
    background: #f4f4f5;
    color: #52525b;
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #f4f4f5;
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .title-row h2 {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.3;
  }

  .category-pill {
    font-size: 0.72rem;
    background: #f4f4f5;
    color: #3f3f46;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .medium {
    margin: 0 0 1.1rem;
    font-size: 0.85rem;
    color: #71717a;
  }

  .card-actions {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid #f4f4f5;
  }

  .like-btn {
    background: #f4f4f5;
    border: none;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: #3f3f46;
    transition: all 0.15s;
  }

  .like-btn.liked {
    background: #ffe4e6;
    color: #e11d48;
  }

  .buy-btn {
    background: #18181b;
    color: #ffffff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .buy-btn:hover {
    background: #e11d48;
  }

  .inquire-btn {
    background: transparent;
    border: 1px solid #d4d4d8;
    color: #3f3f46;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    cursor: pointer;
  }

  /* Modal Styling */
  .modal {
    border: none;
    border-radius: 16px;
    padding: 0;
    width: min(92vw, 480px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .modal::backdrop {
    background: rgba(24, 24, 27, 0.55);
    backdrop-filter: blur(4px);
  }

  .modal-form {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .close-x {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #71717a;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #3f3f46;
  }

  input, select {
    padding: 0.6rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 8px;
    font-size: 0.92rem;
    font-family: inherit;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .full-width {
    width: 100%;
    padding: 0.75rem;
    margin-top: 0.25rem;
  }
</style>
